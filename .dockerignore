# Build-context hygiene for container/Containerfile (podman/docker read this at
# the context root). Keep the context small + force clean in-image builds.
.git
**/__pycache__
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.venv
src/lib/rust/target
**/node_modules
**/.fantastic
integration_tests/tmp
# the CLI's and the app's build trees (a laptop's are large); the server image
# copies one binary, staged at dist/container/ by scripts/build/container.sh
src/target
src/app/target
src/app/node_modules
dist/*
!dist/container
.claude
# ts/dist is large + regenerated; the image copies ONLY the prebuilt bundle.
src/lib/ts/dist/*
!src/lib/ts/dist/js_kernel.zip
