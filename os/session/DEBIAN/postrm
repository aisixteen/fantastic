#!/bin/sh
set -e
if [ -d /run/systemd/system ] && [ "$1" = remove ]; then
  systemctl --system daemon-reload >/dev/null || true
fi
if [ "$1" = remove ] && [ -x /usr/bin/deb-systemd-helper ]; then
  deb-systemd-helper mask fantastic-kiosk.service >/dev/null || true
fi
if [ "$1" = purge ] && [ -x /usr/bin/deb-systemd-helper ]; then
  deb-systemd-helper purge fantastic-kiosk.service >/dev/null || true
  deb-systemd-helper unmask fantastic-kiosk.service >/dev/null || true
  # the user unit's link; the folder /home/fantastic/system is the user's data and stays
  deb-systemd-helper --user purge fantastic-system.service >/dev/null || true
fi
exit 0
