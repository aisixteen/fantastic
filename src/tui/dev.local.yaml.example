endpoint: "<the proxy's /llm/cc/v1/messages URL, from e2e/backends/connection.local.env ENDPOINT>"
model: "<the model id, e.g. from FANTASTIC_AI_MODEL>"
max_tokens: 65536
context_window: 32000        # your call; the harness's squeeze setting is 32000
sampling:                    # the proven fix for the CoT repetition loop
  no_repeat_ngram_size: 3
  repetition_penalty: 1.05
  thinking_token_budget: 8000
