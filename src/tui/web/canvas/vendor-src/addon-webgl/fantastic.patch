diff --git a/addons/addon-webgl/src/SharedContext.ts b/addons/addon-webgl/src/SharedContext.ts
new file mode 100644
index 0000000..aedec84
--- /dev/null
+++ b/addons/addon-webgl/src/SharedContext.ts
@@ -0,0 +1,111 @@
+/**
+ * THE SHARED WEBGL CONTEXT (Aisixteen Fantastic patch): every terminal on the
+ * page renders through ONE WebGL2 context on ONE hidden canvas, then copies
+ * its frame into its own 2D canvas inside its cell. A browser keeps only ~16
+ * WebGL contexts alive per page (the oldest is force-lost past that), so one
+ * context per terminal cannot serve N terminals; one shared context can.
+ *
+ * The shared canvas is an OffscreenCanvas sized to the frame being drawn; the
+ * finished frame is handed to the terminal's `bitmaprenderer` canvas as an
+ * ImageBitmap — `transferToImageBitmap()` / `transferFromImageBitmap()` move
+ * the GPU buffer, no pixel copy and no readback (a `drawImage` copy forced a
+ * GPU flush + sync per terminal update and capped the frame rate).
+ */
+
+import { IWebGL2RenderingContext } from './Types';
+
+export interface ISharedGl {
+  readonly canvas: OffscreenCanvas;
+  readonly gl: IWebGL2RenderingContext;
+}
+
+let current: ISharedGl | undefined;
+
+/** WHAT THE SHARED RENDERER DID, for a probe (E65 load, E66 render fidelity) —
+ *  counters only, plus a way to LOSE the context on purpose (WEBGL_lose_context).
+ *  On `globalThis.__fantasticWebgl`. */
+const stats = { renders: 0, uploads: 0, uploadPx: 0, contexts: 0, pages: 0, released: 0, loseContext: (): void => {}, restoreContext: (): void => {} };
+(globalThis as unknown as { __fantasticWebgl: typeof stats }).__fantasticWebgl = stats;
+export function countRender(): void {
+  stats.renders++;
+}
+
+/** The page's shared context; a new one once the old is lost. */
+export function acquireSharedGl(_doc: Document): ISharedGl {
+  if (current && !current.gl.isContextLost()) {
+    return current;
+  }
+  const canvas = new OffscreenCanvas(256, 256);
+  const gl = canvas.getContext('webgl2', { antialias: false, depth: false, premultipliedAlpha: true, preserveDrawingBuffer: false }) as IWebGL2RenderingContext | null;
+  if (!gl) {
+    throw new Error('WebGL2 not supported');
+  }
+  current = { canvas, gl };
+  stats.contexts++;
+  const lose = gl.getExtension('WEBGL_lose_context');
+  stats.loseContext = () => lose?.loseContext();
+  stats.restoreContext = () => lose?.restoreContext();
+  return current;
+}
+
+/** Size the shared canvas to EXACTLY one terminal's frame: its whole drawing
+ *  buffer is handed over (`transferToImageBitmap`, zero copy) — terminals of one
+ *  size never reallocate it. */
+export function sizeSharedTo(s: ISharedGl, width: number, height: number): void {
+  if (s.canvas.width !== width || s.canvas.height !== height) {
+    s.canvas.width = width;
+    s.canvas.height = height;
+  }
+}
+
+/**
+ * THE ATLAS PAGES, ONCE ON THE GPU: terminals that share a texture atlas (same
+ * font / theme / DPR — CharAtlasCache) now share the GL context too, so a page
+ * is ONE texture, uploaded once per page version, and every renderer BINDS it
+ * to its unit before it draws (texture units are context state: a renderer that
+ * binds only on upload draws with whatever the previous renderer left bound —
+ * another terminal's pages, or the 1×1 red placeholders).
+ */
+interface IPageTexture { texture: WebGLTexture; version: number }
+let pageTextures = new Map<object, IPageTexture>();
+let pagesOf: IWebGL2RenderingContext | undefined;
+
+export function bindPageTexture(gl: IWebGL2RenderingContext, unit: number, page: TexImageSource, version: number): void {
+  if (pagesOf !== gl) {
+    // a new context (the old one lost): its textures went with it
+    pageTextures = new Map();
+    pagesOf = gl;
+  }
+  let e = pageTextures.get(page);
+  if (!e) {
+    e = { texture: gl.createTexture()!, version: -1 };
+    pageTextures.set(page, e);
+    stats.pages = pageTextures.size;
+  }
+  gl.activeTexture(gl.TEXTURE0 + unit);
+  gl.bindTexture(gl.TEXTURE_2D, e.texture);
+  if (e.version !== version) {
+    stats.uploads++;
+    stats.uploadPx += (page as { width: number }).width * (page as { height: number }).height;
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_S, gl.CLAMP_TO_EDGE);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_WRAP_T, gl.CLAMP_TO_EDGE);
+    // glyphs are drawn 1:1: NEAREST samples each texel exactly, so a glyph
+    // re-rasterized at another atlas spot (a clear, a merge) draws the same pixels
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MIN_FILTER, gl.NEAREST);
+    gl.texParameteri(gl.TEXTURE_2D, gl.TEXTURE_MAG_FILTER, gl.NEAREST);
+    gl.texImage2D(gl.TEXTURE_2D, 0, gl.RGBA, gl.RGBA, gl.UNSIGNED_BYTE, page);
+    e.version = version;
+  }
+}
+
+/** A page left its atlas (merged away, or the atlas disposed): its texture goes. */
+export function releasePageTexture(page: object): void {
+  const e = pageTextures.get(page);
+  if (e && pagesOf && !pagesOf.isContextLost()) {
+    pagesOf.deleteTexture(e.texture);
+  }
+  if (pageTextures.delete(page)) {
+    stats.released++;
+  }
+  stats.pages = pageTextures.size;
+}
