# Project-root ignores. Per-tree ignores live alongside the tree
# (rust/.gitignore for the cargo target dir, python/.gitignore for
# venv + caches).

# Scratch / temporary working dir for one-off dumps, notes, traces.
tmp/

# macOS junk.
.DS_Store

# Kernel workdir state — created when running fantastic from the
# repo root for dev/testing. Per-tree clones live under rust/ and
# python/ but the root convenience here gets its own ignore.
.fantastic/

# Claude Code harness state (scheduled tasks, etc.)
.claude/

.env

# Generated container head page (built from readmes by container/head/gen_head.py)
container/head/index.html
# Swift test scratch dirs — bundles under test create real store roots in cwd
# (scheduler sidecars, ws binary-stream blobs). Runtime state, never source.
src/lib/swift/fantastic-sched-*/
src/lib/swift/fantastic-schedfire-*/
src/lib/swift/fantastic-wsbrstream-*/
e2e/backends/sampling.json
e2e/backends/connection.local.env
# Staged kernel artifacts — built from source on demand, never committed.
e2e/dist/
